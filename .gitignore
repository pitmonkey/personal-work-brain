# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Obsidian — keep vault settings, ignore per-machine workspace + cache
.obsidian/workspace.json
.obsidian/workspace-mobile.json
# Community plugins keep their settings — sometimes API keys or tokens — in
# plugins/<id>/data.json. Never commit them; only the core settings ship.
.obsidian/plugins/
.obsidian/community-plugins.json
.obsidian/cache
.trash/

# Python (linter/tooling scratch)
.venv/
__pycache__/
*.pyc

# Untracked working scratch (throwaway files, generation test output).
# Anything worth keeping belongs in raw/ (immutable source) or the concept tree.
scratch/

# inbox/ is the doorstep: a place to drop a source that has not been read,
# judged, or redacted yet, WITHOUT it becoming permanent. Nothing in it is
# committed. The agent promotes a redacted copy into raw/ during ingest.
inbox/*
!inbox/README.md
!inbox/.gitkeep

# Belt and braces — never commit a credential file, even by accident.
# raw/ is immutable and committed, so a secret that lands there is in history.
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
credentials.json
client_secret*.json
*token*.json

# Large binary sources normally live in raw/assets/. If they grow, track them
# with Git LFS instead of committing them directly, e.g.:
#   git lfs track "raw/assets/**"
